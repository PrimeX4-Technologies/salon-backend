{
  "name": "salon-backend",
  "version": "1.0.0",
  "description": "Production-grade single-salon booking, workforce, and customer API",
  "license": "UNLICENSED",
  "author": "primex",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "bootstrap:admin:prod": "node dist/scripts/bootstrap-admin.js",
    "db:indexes": "node dist/scripts/create-indexes.js",
    "db:indexes:dev": "tsx src/scripts/create-indexes.ts",
    "worker:operations": "tsx src/workers/operations.worker.ts all",
    "worker:outbox": "tsx src/workers/operations.worker.ts outbox",
    "worker:notifications": "tsx src/workers/operations.worker.ts notifications",
    "worker:integrations": "tsx src/workers/operations.worker.ts integrations",
    "worker:payment-webhooks": "tsx src/workers/operations.worker.ts payment-webhooks",
    "worker:booking-lifecycle": "tsx src/workers/operations.worker.ts booking-lifecycle",
    "worker:operations:prod": "node dist/workers/operations.worker.js all",
    "worker:outbox:prod": "node dist/workers/operations.worker.js outbox",
    "worker:notifications:prod": "node dist/workers/operations.worker.js notifications",
    "worker:integrations:prod": "node dist/workers/operations.worker.js integrations",
    "worker:payment-webhooks:prod": "node dist/workers/operations.worker.js payment-webhooks",
    "worker:booking-lifecycle:prod": "node dist/workers/operations.worker.js booking-lifecycle",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test:run"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
