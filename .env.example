NODE_ENV=development
TZ=Asia/Colombo
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/salon_db
REDIS_URL=redis://127.0.0.1:6379
# Use independent, cryptographically random secrets (at least 32 bytes each).
# Example generator: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_at_least_32_bytes
JWT_REFRESH_SECRET=replace_with_a_different_random_refresh_secret_32_bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=salon-booking-api
JWT_AUDIENCE=salon-booking-client
# Required only when customer Google sign-in is enabled.
GOOGLE_CLIENT_ID=
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_SECONDS=900
AUTH_REFRESH_COOKIE_NAME=salon_refresh
AUTH_CSRF_COOKIE_NAME=salon_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Keep false for browsers; native/trusted clients may opt in and store it securely.
AUTH_RETURN_REFRESH_TOKEN=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX=10
# Independent secret used to hash and encrypt one-time account-action tokens.
AUTH_ACTION_TOKEN_SECRET=replace_with_another_random_action_token_secret_32_bytes
AUTH_PASSWORD_RESET_TTL_SECONDS=900
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
# Optional until encrypted push tokens or signed payment-webhook persistence is used.
# Generate 32 bytes: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY=
# One-time CLI bootstrap (`npm run bootstrap:admin`). Remove the password after use.
BOOTSTRAP_ADMIN_NAME=Salon Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_one_time_password
CORS_ORIGIN=http://localhost:5173
# Global per-client API safety limit. Auth and public availability also have
# narrower endpoint-specific limits.
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX=1000
PAYMENT_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
PAYMENT_WEBHOOK_RATE_LIMIT_MAX=300
TRUST_PROXY=false
REQUEST_BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000
